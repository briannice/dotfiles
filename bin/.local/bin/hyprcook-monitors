#!/bin/bash

laptop_screen="eDP-1"
hdmi_screen="HDMI-A-1"

case "$1" in
    laptop)
        hyprctl eval "hl.monitor({ output = '$laptop_screen', mode = 'preferred', position = 'auto', scale = 1.5 })"
        hyprctl eval "hl.monitor({ output = '$hdmi_screen', disabled = true })"
        ;;

    smon)
        hyprctl eval "hl.monitor({ output = '$hdmi_screen', mode = 'preferred', position = 'auto', scale = 2 })"
        hyprctl eval "hl.monitor({ output = '$laptop_screen', disabled = true })"
        ;;

    *)
        echo "Argument 1 missing: profile = [laptop | smon]"
        exit 1
        ;;
esac